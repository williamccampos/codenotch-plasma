#!/usr/bin/env python3
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
VENDOR = "/usr/share/codenotch-plasma/vendor"
if os.path.isdir(VENDOR):
    sys.path.insert(0, VENDOR)

CANDIDATES = [
    os.path.join(os.path.dirname(HERE), "src"),
    "/usr/share/codenotch-plasma/src",
    os.path.expanduser("~/.local/share/codenotch-plasma/src"),
]
for candidate in CANDIDATES:
    if os.path.isdir(os.path.join(candidate, "codenotch_plasma")):
        sys.path.insert(0, candidate)
        break
else:
    sys.stderr.write("codenotch-plasma: source tree not found\n")
    raise SystemExit(1)

from codenotch_plasma.__main__ import main

if __name__ == "__main__":
    raise SystemExit(main())
